# Set default behavior to normalize line endings to LF on commit
* text=auto eol=lf

# Kotlin and Gradle source files (explicit Linux LF newline)
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.java text eol=lf
*.groovy text eol=lf

# Configuration, metadata, and documentation
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Executable shell scripts
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts (must use CRLF)
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never normalize or attempt text diff
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
